#!/usr/bin/env bash
set -euo pipefail

find_forbidden_staged_paths() {
  git diff --cached --name-only --diff-filter=ACMR -z |
    while IFS= read -r -d '' path; do
      case "$path" in
        .private_validation/*|deploy-evidence.txt)
          printf '%s\n' "$path"
          ;;
      esac
    done
}

forbidden_paths="$(find_forbidden_staged_paths)"
readonly forbidden_paths

if [[ -n "$forbidden_paths" ]]; then
  printf '%s\n' \
    'V7 repository guard: private validation/evidence output cannot be committed.' \
    'Remove these staged paths before committing:' >&2
  printf '%s\n' "$forbidden_paths" >&2
  exit 1
fi
