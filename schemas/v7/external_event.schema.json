{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polymarket_v7_external_event_v1",
  "title": "V7 normalized external event",
  "type": "object",
  "required": ["schema_version", "source_id", "provider", "venue", "asset", "instrument_id", "instrument_type", "channel", "event_kind", "local_receive_wall_ns", "local_receive_monotonic_ns", "normalization_complete_monotonic_ns", "connection_epoch", "snapshot_or_delta", "gap_before_event", "recovery_state", "stale", "healthy", "parser_version", "raw_payload_hash", "normalized_payload_hash", "repository_sha", "run_id"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "asset": {"type": "string", "minLength": 1},
    "instrument_id": {"type": "string", "minLength": 1},
    "instrument_type": {"type": "string", "minLength": 1},
    "market_id": {"type": "string"},
    "channel": {"type": "string", "minLength": 1},
    "event_kind": {"enum": ["BOOK_SNAPSHOT", "BOOK_DELTA", "BEST_BID_ASK", "TRADE", "MARK_PRICE", "INDEX_PRICE", "FUNDING", "OPEN_INTEREST", "LIQUIDATION", "OPTION_TICKER", "OPTION_SURFACE", "VOLATILITY_INDEX", "ORACLE_OBSERVATION", "PREDICTION_MARKET_BOOK", "PREDICTION_MARKET_TRADE", "MARKET_METADATA", "SPORTS_STATE", "SPORTS_EVENT", "OFFICIAL_ANNOUNCEMENT", "CORRECTION", "HEARTBEAT", "SOURCE_STATUS"]},
    "source_sequence": {"type": ["integer", "null"], "minimum": 0},
    "source_event_timestamp_ns": {"type": ["integer", "null"], "minimum": 0},
    "source_publish_timestamp_ns": {"type": ["integer", "null"], "minimum": 0},
    "local_receive_wall_ns": {"type": "integer", "minimum": 1},
    "local_receive_monotonic_ns": {"type": "integer", "minimum": 1},
    "normalization_complete_monotonic_ns": {"type": "integer", "minimum": 1},
    "connection_epoch": {"type": "integer", "minimum": 1},
    "snapshot_or_delta": {"enum": ["SNAPSHOT", "DELTA", "POINT", "NONE"]},
    "gap_before_event": {"type": "boolean"},
    "recovery_state": {"enum": ["VALID", "VALID_DEGRADED", "STALE", "GAPPED", "RECOVERING", "INVALID_BOOK", "CLOCK_ANOMALY", "SOURCE_DOWN"]},
    "stale": {"type": "boolean"},
    "healthy": {"type": "boolean"},
    "parser_version": {"type": "string", "minLength": 1},
    "raw_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "normalized_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
