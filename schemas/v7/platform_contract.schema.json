{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.example/schemas/v7/platform_contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_mode_on_drift", "max_snapshot_age_seconds", "last_verified_at", "official_sources", "api", "contracts", "protocol", "market_contract", "data_api", "market_constraints"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_mode_on_drift": {"enum": ["SHADOW_LIVE_READ_ONLY", "CANCEL_ONLY"]},
    "max_snapshot_age_seconds": {"type": "integer", "minimum": 1},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "official_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://docs\\.polymarket\\.com/"}},
    "api": {"type": "object"},
    "contracts": {"type": "object"},
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1_auth", "l2_auth", "exchange_eip712_domain_version", "order_heartbeat_endpoint", "order_heartbeat_required", "matching_engine_restart_status", "post_restart_post_only_seconds", "authenticated_orders_endpoint", "authenticated_trades_endpoint", "authenticated_pagination"],
      "properties": {
        "l1_auth": {"const": "EIP-712 ClobAuthDomain version 1"},
        "l2_auth": {"const": "HMAC-SHA256"},
        "exchange_eip712_domain_version": {"const": "2"},
        "order_heartbeat_endpoint": {"const": "/heartbeats"},
        "order_heartbeat_required": {"const": true},
        "matching_engine_restart_status": {"const": 425},
        "post_restart_post_only_seconds": {"const": 120},
        "authenticated_orders_endpoint": {"const": "/data/orders"},
        "authenticated_trades_endpoint": {"const": "/data/trades"},
        "authenticated_pagination": {"const": "cursor"}
      }
    },
    "market_contract": {"type": "object"},
    "data_api": {"type": "object"},
    "market_constraints": {"type": "object"}
  }
}
