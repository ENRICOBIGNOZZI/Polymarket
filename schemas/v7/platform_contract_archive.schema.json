{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.example/schemas/v7/platform_contract_archive.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "exact_code_sha", "run_id", "registry_sha256", "snapshot", "source_documents", "monitor_report"],
  "properties": {
    "schema": {"const": "polymarket_v7_platform_contract_archive_v1"},
    "exact_code_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "registry_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "snapshot": {"type": "object"},
    "source_documents": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "monitor_report": {"type": "object"}
  }
}
