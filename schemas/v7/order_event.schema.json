{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://polymarket.example/schemas/v7/order_event.schema.json","type":"object","additionalProperties":false,"required":["schema_version","event_id","run_id","exact_code_sha","execution_mode","order_id","state","event_timestamp","previous_event_hash","event_hash"],"properties":{"schema_version":{"const":1},"event_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"exact_code_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"execution_mode":{"type":"string"},"order_id":{"type":"string","minLength":1},"state":{"enum":["INTENT_CREATED","RISK_APPROVED","SIGNING_REQUESTED","SIGNED","SUBMITTING","ACK_LIVE","ACK_MATCHED","ACK_DELAYED","ACK_UNMATCHED","PARTIALLY_FILLED","FILLED","CANCEL_REQUESTED","CANCEL_ACKNOWLEDGED","EXPIRED","REJECTED","UNKNOWN_AFTER_TIMEOUT","SETTLEMENT_PENDING","SETTLED","RECOVERY_ORPHAN","TERMINAL"]},"event_timestamp":{"type":"string","format":"date-time"},"previous_event_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"event_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}
