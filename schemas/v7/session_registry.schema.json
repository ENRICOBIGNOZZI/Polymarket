{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.example/schemas/v7/session_registry.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_sha", "wallet_id_hash", "sessions", "registry_evidence_hash"],
  "properties": {
    "schema": {"const": "polymarket_v7_session_registry_v1"},
    "model_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "wallet_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "registry_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["session_key_id_hash", "activated_at_ms", "retired_at_ms", "registration_evidence_hash"],
        "properties": {
          "session_key_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "activated_at_ms": {"type": "integer", "minimum": 1},
          "retired_at_ms": {"type": ["integer", "null"], "minimum": 1},
          "registration_evidence_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
