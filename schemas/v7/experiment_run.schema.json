{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.example/schemas/v7/experiment_run.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "attempt",
    "experiment_id",
    "experiment_sha256",
    "code_sha",
    "data_manifest",
    "random_seed",
    "resume_of_run_sha256",
    "started_at",
    "ended_at",
    "wall_time_seconds",
    "resource_usage",
    "cached_intermediates",
    "stopping_condition",
    "status",
    "failure_reason",
    "output_hashes",
    "run_sha256"
  ],
  "properties": {
    "schema": {
    "const": "polymarket_v7_experiment_run"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "experiment_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "code_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "data_manifest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "random_seed": {
      "type": "integer",
      "minimum": 0
    },
    "resume_of_run_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "ended_at": {
      "type": "string",
      "minLength": 1
    },
    "wall_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "resource_usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_seconds",
        "gpu_seconds",
        "peak_memory_bytes"
      ],
      "properties": {
        "cpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "gpu_seconds": {
          "type": "number",
          "minimum": 0
        },
        "peak_memory_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cached_intermediates": {
      "type": "array"
    },
    "stopping_condition": {
      "enum": [
        "COMPLETED",
        "BUDGET_EXHAUSTED",
        "EXTERNAL_STOP",
        "FAILURE"
      ]
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED",
        "STOPPED"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_hashes": {
      "type": "array"
    },
    "run_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
