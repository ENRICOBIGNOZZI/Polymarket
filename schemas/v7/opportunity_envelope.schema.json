{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.example/schemas/v7/opportunity_envelope.schema.json",
  "title": "V7 Opportunity Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "model_sha", "config_hash", "policy_hash", "run_id",
    "source_snapshot_identity", "engine_id", "component_provenance", "market_id",
    "event_id", "contract_id", "mapping_identity", "crypto_context", "action", "side",
    "decision_receive_timestamp_ns", "source_event_timestamps_ns", "fair_value",
    "conservative_expected_wealth_change", "cost_vector", "cost_authority",
    "uncertainty", "calibration_status", "latency", "capacity", "execution_plan",
    "inventory_delta", "portfolio_exposure_delta", "settlement", "eligible",
    "reasons", "deterministic_replay_key", "expires_at_ns"
  ],
  "properties": {
    "settlement_model": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "model_hash", "code_sha", "token_probability", "observed_at_ns", "rich_feature_sha256"],
      "properties": {
        "model_id": {"type": ["string", "null"], "minLength": 1},
        "model_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "code_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "token_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "observed_at_ns": {"type": "integer", "minimum": 1},
        "rich_feature_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "schema": {"const": "polymarket_v7_opportunity_envelope_v1"},
    "version": {"const": 1},
    "model_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "source_snapshot_identity": {"type": "string", "minLength": 1},
    "engine_id": {"enum": ["CRYPTO_SETTLEMENT_ENGINE", "STRUCTURAL_ARB_ENGINE"]},
    "component_provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "market_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "contract_id": {"type": "string", "minLength": 1},
    "mapping_identity": {"type": "string", "minLength": 1},
    "crypto_context": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["asset", "horizon", "contract_family", "settlement_semantic_hash", "authority", "research_only"],
          "properties": {
            "asset": {"enum": ["BTC", "ETH", "SOL", "XRP", "DOGE", "BNB"]},
            "horizon": {"enum": ["M1", "M5", "M15", "H1", "H4"]},
            "contract_family": {"type": "string", "minLength": 1},
            "settlement_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "authority": {"enum": ["SHADOW", "SHADOW_ZERO_AUTHORITY", "PAPER", "PAPER_EXPLORATION"]},
            "research_only": {"type": "boolean"}
          }
        }
      ]
    },
    "action": {"enum": ["MAKE", "TAKE", "ARB", "CANCEL", "WITHDRAW", "NOTHING"]},
    "side": {"enum": ["BUY", "SELL", "YES", "NO", "NONE", "MULTI"]},
    "decision_receive_timestamp_ns": {"type": "integer", "minimum": 1},
    "source_event_timestamps_ns": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "fair_value": {
      "type": "object", "additionalProperties": false,
      "required": ["lower", "point", "upper"],
      "properties": {"lower": {"type": "number", "minimum": 0, "maximum": 1}, "point": {"type": "number", "minimum": 0, "maximum": 1}, "upper": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "execution_alpha": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "outcome",
        "evidence_status",
        "fill_probability",
        "queue_ahead_shares",
        "action_ev",
        "attribution"
      ],
      "properties": {
        "schema": {
          "const": "polymarket_v7_execution_alpha_packet_v1"
        },
        "action": {
          "enum": [
            "MAKE",
            "TAKE",
            "CANCEL",
            "NOTHING"
          ]
        },
        "outcome": {
          "enum": [
            "YES",
            "NO",
            "NONE"
          ]
        },
        "evidence_status": {
          "enum": [
            "MATURE",
            "IMMATURE"
          ]
        },
        "fill_probability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lower",
            "point",
            "upper"
          ],
          "properties": {
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "point": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "queue_ahead_shares": {
          "type": "number",
          "minimum": 0
        },
        "action_ev": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "conservative",
            "point"
          ],
          "properties": {
            "conservative": {
              "type": "number"
            },
            "point": {
              "type": "number"
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settlement_alpha",
            "spread_capture",
            "rebate",
            "fees",
            "slippage",
            "adverse_selection",
            "latency",
            "inventory",
            "unwind",
            "cancel",
            "capital"
          ],
          "properties": {
            "settlement_alpha": {
              "type": "number"
            },
            "spread_capture": {
              "type": "number"
            },
            "rebate": {
              "type": "number"
            },
            "fees": {
              "type": "number"
            },
            "slippage": {
              "type": "number"
            },
            "adverse_selection": {
              "type": "number"
            },
            "latency": {
              "type": "number"
            },
            "inventory": {
              "type": "number"
            },
            "unwind": {
              "type": "number"
            },
            "cancel": {
              "type": "number"
            },
            "capital": {
              "type": "number"
            }
          }
        }
      }
    },
    "conservative_expected_wealth_change": {"type": "number"},
    "cost_vector": {"type": "object"},
    "cost_authority": {"type": "object"},
    "uncertainty": {"type": "object"},
    "calibration_status": {"enum": ["MATURE", "IMMATURE", "MISSING", "NOT_APPLICABLE"]},
    "latency": {"type": "object"},
    "capacity": {"type": "object"},
    "execution_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atomic_unit_id", "execution_style", "legs", "partial_fill_plan", "timeout_ms", "unwind_plan"],
      "properties": {
        "atomic_unit_id": {"type": "string", "minLength": 1},
        "execution_style": {"enum": ["SINGLE_LEG", "SEQUENTIAL_ATOMIC_INTENT"]},
        "legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["leg_id", "market_id", "contract_id", "token_id", "side", "target_quantity", "limit_price", "fee_authority"],
            "properties": {
              "leg_id": {"type": "string", "minLength": 1},
              "market_id": {"type": "string", "minLength": 1},
              "contract_id": {"type": "string", "minLength": 1},
              "token_id": {"type": "string", "minLength": 1},
              "side": {"enum": ["BUY", "SELL"]},
              "target_quantity": {"type": "number", "exclusiveMinimum": 0},
              "limit_price": {"type": "number", "minimum": 0, "maximum": 1},
              "fee_authority": {"enum": ["AUTHORITATIVE", "CONSERVATIVE_BOUND", "CONSERVATIVE_ZERO"]}
            }
          }
        },
        "partial_fill_plan": {"enum": ["CANCEL_REMAINDER", "COMPLETE_OR_UNWIND", "NO_NEW_RISK"]},
        "timeout_ms": {"type": "integer", "minimum": 0},
        "unwind_plan": {"enum": ["NONE", "FULL_DEPTH_BOUNDED_UNWIND", "CANCEL_ONLY"]}
      }
    },
    "forward_test": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "strategy_id", "protocol_hash", "research_only", "automatic_promotion", "one_entry_per_market", "hold_to_settlement", "entry_uses_absolute_fair", "probability_source"],
      "properties": {
        "mode": {"const": "PAPER_FORWARD_TEST"},
        "strategy_id": {"const": "LEAD_LAG_TAKER_V1"},
        "protocol_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "research_only": {"const": true}, "automatic_promotion": {"const": false},
        "one_entry_per_market": {"const": true}, "hold_to_settlement": {"const": true},
        "entry_uses_absolute_fair": {"const": false}, "probability_source": {"const": "POLYMARKET_PRIOR_ONLY"}
      }
    },
    "multi_crypto_forward": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "experiment_id", "protocol_hash", "feature_schema_hash", "model_hash", "fill_model_hash", "cost_model_hash", "settlement_semantic_hash", "latency_profile_id", "asset", "horizon", "research_only", "automatic_promotion", "one_entry_per_market", "hold_to_settlement", "entry_uses_absolute_fair", "probability_source"],
      "properties": {
        "mode": {"const": "PAPER_MULTI_CRYPTO_FORWARD"},
        "experiment_id": {"type": "string", "minLength": 1},
        "protocol_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "feature_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "fill_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cost_model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "settlement_semantic_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "latency_profile_id": {"type": "string", "minLength": 1},
        "asset": {"enum": ["BTC", "ETH", "SOL", "XRP", "DOGE", "BNB"]},
        "horizon": {"enum": ["M5", "M15"]},
        "research_only": {"const": true}, "automatic_promotion": {"const": false},
        "one_entry_per_market": {"const": true}, "hold_to_settlement": {"const": true},
        "entry_uses_absolute_fair": {"const": false}, "probability_source": {"const": "POLYMARKET_PRIOR_ONLY"}
      }
    },
    "exploration": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "point_expected_wealth_change", "maximum_probe_loss", "probe_loss_cap", "information_score", "research_only", "robust_candidate", "arrival_revalidated", "model_id", "model_hash"],
      "properties": {
        "mode": {"const": "PAPER_BOOTSTRAP_PROBE"},
        "point_expected_wealth_change": {"type": "number"}, "maximum_probe_loss": {"type": "number", "exclusiveMinimum": 0},
        "probe_loss_cap": {"type": "number", "exclusiveMinimum": 0}, "information_score": {"type": "number", "exclusiveMinimum": 0},
        "research_only": {"const": true}, "robust_candidate": {"const": false}, "arrival_revalidated": {"const": true},
        "model_id": {"type": "string", "minLength": 1}, "model_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "maker_execution_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_hash", "config_hash", "execution_semantics_version"],
      "properties": {
        "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "config_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "execution_semantics_version": {"const": "maker-paper-v7.2-bilateral-inventory"}
      }
    },
    "inventory_delta": {"type": "number"},
    "portfolio_exposure_delta": {"type": "number"},
    "settlement": {"type": "object"},
    "eligible": {"type": "boolean"},
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "deterministic_replay_key": {"type": "string", "minLength": 1},
    "expires_at_ns": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"engine_id": {"const": "CRYPTO_SETTLEMENT_ENGINE"}}},
      "then": {"properties": {"crypto_context": {"type": "object"}}},
      "else": {"properties": {"crypto_context": {"type": "null"}}}
    }
  ]
}
