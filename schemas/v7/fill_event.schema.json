{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://polymarket.example/schemas/v7/fill_event.schema.json","type":"object","additionalProperties":false,"required":["schema_version","fill_id","order_id","run_id","exact_code_sha","condition_id","token_id","side","price","size_base_units","fee_base_units","source_event_hash","event_timestamp"],"properties":{"schema_version":{"const":1},"fill_id":{"type":"string","minLength":1},"order_id":{"type":"string","minLength":1},"run_id":{"type":"string","minLength":1},"exact_code_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"condition_id":{"type":"string","minLength":1},"token_id":{"type":"string","minLength":1},"side":{"enum":["BUY","SELL"]},"price":{"type":"string","pattern":"^[0-9]+(\\.[0-9]+)?$"},"size_base_units":{"type":"integer","minimum":1},"fee_base_units":{"type":"integer","minimum":0},"source_event_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"event_timestamp":{"type":"string","format":"date-time"}}}
