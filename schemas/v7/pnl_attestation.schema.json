{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "V7 real PnL attestation package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_at", "operator_id", "model_sha", "report_sha256", "automatic_promotion", "package_files", "manifest_sha256"],
  "properties": {
    "schema": {"const": "polymarket_v7_pnl_attestation_package_v1"},
    "created_at": {"type": "string", "format": "date-time"},
    "model_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operator_id": {"type": "string", "minLength": 1},
    "package_files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "automatic_promotion": {"const": false}
  }
}
