# Copy to .env in the repository root or export these variables before docker compose.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-local-password
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
EXPORTER_PORT=9108
PROMETHEUS_RETENTION=30d
# auto = monitor the highest paper_v* runtime directory. Override only to pin a historical run.
POLYMARKET_RUN_NAME=auto
