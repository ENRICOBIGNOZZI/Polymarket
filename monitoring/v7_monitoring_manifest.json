{
  "schema": "polymarket_v7_monitoring_manifest_v2",
  "version": 7,
  "paper_only": true,
  "authenticated_execution": false,
  "run_root": "runs/paper_v7_live",
  "exporter": {
    "path": "monitoring/exporter_v7_fillability.py",
    "composition": "maker_fillability_plus_external_fair",
    "host": "127.0.0.1",
    "port": 9108,
    "health_path": "/healthz",
    "metrics_path": "/metrics",
    "maker_fillability_path": "/maker-fillability.json",
    "external_fair_path": "/external-fair.json"
  },
  "prometheus": {
    "config": "monitoring/prometheus_v7.yml",
    "alert_rules": "monitoring/v7_alerts.yml",
    "host": "127.0.0.1",
    "port": 9090
  },
  "grafana": {
    "canonical_operator_home": true,
    "dashboard_uid": "polymarket-v7",
    "dashboard_file": "monitoring/grafana/dashboards/polymarket-v7.json",
    "maker_fillability_dashboard": "monitoring/grafana/dashboards/polymarket-v7-maker-fillability.json",
    "external_fair_dashboard": "monitoring/grafana/dashboards/polymarket-v7-external-fair.json",
    "latency_dashboard": "monitoring/grafana/dashboards/polymarket-v7-latency.json",
    "datasource_uid": "prometheus-v7",
    "datasource_file": "monitoring/grafana/provisioning/datasources/prometheus-v7.yml",
    "provider_file": "monitoring/grafana/provisioning/dashboards/v7.yml",
    "host": "127.0.0.1",
    "port": 3000
  },
  "supervision": {
    "policy": "config/v7_runtime_supervision.json",
    "supervisor": "ops/v7_runtime_supervisor.py",
    "entrypoint": "ops/v7_service_entrypoint.sh",
    "status": "control/supervisor_status.json",
    "single_writer_metric": "polymarket_v7_single_writer_ok",
    "exact_sha_metric": "polymarket_v7_exact_sha_ok",
    "bounded_restart_metric": "polymarket_v7_restart_count_window"
  },
  "retention": {
    "policy": "config/v7_data_retention.json",
    "runner": "monitoring/v7_retention.py",
    "status": "control/retention_status.json",
    "canonical_ledger_mode": "immutable_checkpoint_never_delete",
    "durable_archive_required_before_local_prune": true
  },
  "external_fair": {
    "policy": "config/v7_external_fair.json",
    "status": "external_fair/status.json",
    "contract_registry": "external_fair/contract_registry.json",
    "model_registry": "external_fair/model_registry",
    "report": "scripts/v7_external_fair_report.py",
    "shadow_missing_does_not_fail_health": true,
    "active_invalid_state_fails_closed": true
  },
  "required_surfaces": [
    "control/runtime_status.json",
    "control/incumbent_identity.json",
    "control/portfolio_state.json",
    "control/allocations/manifest.json",
    "graph_rv/status.json",
    "canonical_economics.json",
    "ledger/execution.jsonl",
    "trade_tape.csv"
  ],
  "freshness_seconds": {
    "portfolio": 30,
    "runtime": 180,
    "graph": 180,
    "economics": 180,
    "trade_tape": 180,
    "external_fair_oracle": 2
  },
  "retired_surfaces": [
    "v7_supervisor.json",
    "execution/v7_execution_supervisor.json",
    "execution/market_proxy_status.json"
  ]
}
