[Unit]
Description=Polymarket V7 model-independent research collection plane (@EXPECTED_SHA@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@
Environment=PM_V7_COLLECTION_ROOT=@COLLECTION_ROOT@
Environment=PM_V7_COLLECTION_SHA=@EXPECTED_SHA@
Environment=PM_V7_AUTHENTICATED_EXECUTION=0
Environment=PM_V7_REAL_ORDER_SUBMISSION=0
ExecStart=@APP_DIR@/scripts/v7_collection_plane.sh
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@COLLECTION_ROOT@

[Install]
WantedBy=multi-user.target
