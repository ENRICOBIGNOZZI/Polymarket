[Unit]
Description=Polymarket V7 canonical monitoring exporter
After=polymarket-v7-paper.service
PartOf=polymarket-v7-paper.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 @APP_DIR@/monitoring/exporter_v7.py --run-root @RUN_ROOT@ --repository-root @APP_DIR@ --host 127.0.0.1 --port 9108
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=@RUN_ROOT@

[Install]
WantedBy=multi-user.target
