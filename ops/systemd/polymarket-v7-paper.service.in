[Unit]
Description=Polymarket V7 canonical FULL-PAPER supervisor (@EXPECTED_SHA@)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=3

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@
Environment=POLYMARKET_APP_DIR=@APP_DIR@
Environment=PM_V7_RUN_ROOT=@RUN_ROOT@
Environment=POLYMARKET_EXPECTED_SHA=@EXPECTED_SHA@
Environment=PM_V7_AUTHENTICATED_EXECUTION=0
Environment=PM_V7_REAL_ORDER_SUBMISSION=0
ExecStart=@APP_DIR@/ops/v7_service_entrypoint.sh
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@RUN_ROOT@

[Install]
WantedBy=multi-user.target
