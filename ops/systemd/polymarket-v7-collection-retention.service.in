[Unit]
Description=Polymarket V7 independent collection retention
After=polymarket-v7-collection.service
Requires=polymarket-v7-collection.service

[Service]
Type=oneshot
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@APP_DIR@
ExecStart=/usr/bin/python3 @APP_DIR@/monitoring/v7_london_buffer_retention.py --run-root @COLLECTION_ROOT@ --config @APP_DIR@/config/v7_london_buffer_retention.json
Nice=15
TimeoutStartSec=900
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@COLLECTION_ROOT@ -@COLLECTION_ARCHIVE_ROOT@
