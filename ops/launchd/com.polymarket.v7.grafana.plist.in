<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.polymarket.v7.grafana</string>
  <key>ProgramArguments</key><array>
    <string>@GRAFANA_BIN@</string><string>server</string>
    <string>--homepath=@GRAFANA_HOME@</string>
    <string>--config=@STATE_DIR@/grafana.ini</string>
    <string>cfg:default.paths.data=@APP_DIR@/runs/monitoring/grafana/data</string>
    <string>cfg:default.paths.logs=@APP_DIR@/runs/monitoring/grafana/logs</string>
    <string>cfg:default.paths.plugins=@APP_DIR@/runs/monitoring/grafana/plugins</string>
    <string>cfg:default.paths.provisioning=@STATE_DIR@/grafana/provisioning</string>
  </array>
  <key>WorkingDirectory</key><string>@APP_DIR@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>@RUN_ROOT@/grafana-v7.log</string>
  <key>StandardErrorPath</key><string>@RUN_ROOT@/grafana-v7.log</string>
</dict></plist>
