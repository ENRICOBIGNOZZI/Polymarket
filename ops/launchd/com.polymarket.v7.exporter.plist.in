<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.polymarket.v7.exporter</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string><string>@APP_DIR@/monitoring/exporter_v7.py</string>
    <string>--run-root</string><string>@RUN_ROOT@</string>
    <string>--repository-root</string><string>@APP_DIR@</string>
    <string>--host</string><string>127.0.0.1</string><string>--port</string><string>9108</string>
  </array>
  <key>WorkingDirectory</key><string>@APP_DIR@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@RUN_ROOT@/monitoring-exporter.log</string>
  <key>StandardErrorPath</key><string>@RUN_ROOT@/monitoring-exporter.log</string>
</dict></plist>
