{
  "schema": "polymarket_v7_crypto_settlement_engine_v1",
  "version": 1,
  "paper_only": true,
  "authenticated_execution": false,
  "real_order_submission": false,
  "automatic_promotion": false,
  "decision_owner": "CRYPTO_SETTLEMENT_ENGINE",
  "market_registry": "config/v7_crypto_settlement_markets.json",
  "model_registry": "config/v7_crypto_settlement_model_registry.json",
  "authority_registry": "config/v7_authority_registry.json",
  "opportunity_contract": "schemas/v7/opportunity_envelope.schema.json",
  "global_portfolio_coordinator": "V7_GLOBAL_PORTFOLIO_COORDINATOR",
  "shared_owners": {
    "oms": "V7_CANONICAL_OMS",
    "inventory": "V7_CANONICAL_INVENTORY",
    "risk": "V7_CANONICAL_RISK",
    "capital": "V7_CANONICAL_ALLOCATOR",
    "ledger": "V7_CANONICAL_LEDGER"
  },
  "component_families": [
    "crypto_settlement_fair",
    "crypto_informed_taker",
    "professional_maker"
  ],
  "component_independent_authority": false,
  "action_space": ["MAKE", "TAKE", "CANCEL", "WITHDRAW", "NOTHING"],
  "alpha_selection": "MAX_CONSERVATIVE_EXPECTED_CHANGE_IN_ACCOUNT_WEALTH",
  "risk_actions_preempt_alpha": true,
  "external_update_policy": {
    "oracle_or_external_update_can_cancel_without_polymarket_book_event": true,
    "oracle_or_external_update_can_reprice_without_polymarket_book_event": true,
    "stale_quote_behavior": "CANCEL_OR_NOTHING"
  },
  "fair_value": {
    "separate_model_per_horizon": true,
    "separate_frozen_model_per_asset_horizon": true,
    "model_registry_index": ["asset", "horizon", "settlement_semantic_hash"],
    "fixed_bridge_coefficient_authorized": false,
    "empirical_frozen_artifact_required": true,
    "settlement_source": "REGISTRY_VERIFIED_CHAINLINK_TWAP_60S",
    "settlement_source_may_be_replaced_by_predictor": false,
    "predictors": [
      "CHAINLINK_30_SECOND_TWAP",
      "ASSET_USD_SPOT_COMPOSITE",
      "ASSET_USDT_SPOT_COMPOSITE",
      "BTC_CROSS_ASSET_STATE",
      "CRYPTO_WIDE_STATE",
      "USD_USDT_BASIS",
      "SPOT_L2_OFI",
      "PERPETUAL_L2_OFI",
      "SPOT_PERP_BASIS",
      "LIQUIDATIONS",
      "OPEN_INTEREST_CHANGE",
      "DERIBIT_VOLATILITY",
      "POLYMARKET_MICROSTRUCTURE"
    ],
    "direct_chainlink_data_streams_role": "SAME_ORACLE_RECOVERY_CHALLENGER",
    "direct_chainlink_data_streams_execution_authority": false
  },
  "latency": {
    "artifact_schema": "polymarket_v7_empirical_latency_profile_v1",
    "configured_constants_are_observations": false,
    "missing_profile_behavior": "CANCEL_AND_NOTHING_ONLY",
    "minimum_samples": 100,
    "required_percentiles": ["p50", "p90", "p95", "p99", "p99.9", "max"],
    "required_segments": [
      "taker_arrival",
      "maker_place_ack",
      "maker_cancel_ack",
      "private_ws_confirmation"
    ],
    "economic_quantile": "p99"
  },
  "maker_economics": {
    "artifact_schema": "polymarket_v7_maker_execution_evidence_v1",
    "minimum_orders": 50,
    "reach_and_fill_are_separate": true,
    "fill_conditioned_markout_required": true,
    "rebate_requires_execution": true,
    "quote_candidate_generation": true,
    "reach_estimation": true,
    "conditional_fill_given_reach_estimation": true,
    "queue_priority_model": true,
    "fill_conditioned_markout": true,
    "cancel_latency_stale_risk_model": true,
    "inventory_aware_skew": true,
    "fee_and_rebate_authority_required": true,
    "quote_lifecycle_diagnostics": true,
    "independent_capital_oms_inventory_ledger_authority": false,
    "formula": "P_L(reach)*P_L(fill_given_reach)*(capture+rebate_L-markout_U-cancel_latency_risk)-inventory_cost-cancel_cost-capital_cost"
  },
  "horizons": [
    {
      "id": "M5",
      "horizon_seconds": 300,
      "model_scope": "ASSET_USD_UPDOWN_5M",
      "authority": "SHADOW",
      "research_only": false,
      "maker": {"enabled": true, "minimum_tte_seconds": 120, "maximum_tte_seconds": 300},
      "taker": {"enabled": true, "minimum_tte_seconds": 5, "maximum_tte_seconds": 120},
      "under_five_seconds": "NO_NEW_RISK"
    },
    {
      "id": "M15",
      "horizon_seconds": 900,
      "model_scope": "ASSET_USD_UPDOWN_15M",
      "authority": "SHADOW",
      "research_only": false,
      "maker": {"enabled": true, "minimum_tte_seconds": 30, "maximum_tte_seconds": 900},
      "taker": {"enabled": true, "minimum_tte_seconds": 5, "maximum_tte_seconds": 120},
      "under_five_seconds": "NO_NEW_RISK"
    }
  ]
}
