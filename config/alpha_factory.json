{
  "schema": "polymarket_alpha_factory_config_v1",
  "paper_only": true,
  "allow_authenticated_execution": false,
  "allow_direct_champion_mutation": false,
  "champion_manifest": "config/live_champion.json",
  "telemetry": {
    "live_smoke": "telemetry/latest-live-smoke.json",
    "forward_maker": "telemetry/latest-forward-maker.json",
    "forward_maker_history": "telemetry/forward-maker-history.jsonl",
    "max_live_smoke_age_seconds": 10800,
    "max_forward_age_seconds": 10800,
    "max_autonomous_research_age_seconds": 5400
  },
  "gates": {
    "min_oos_trades": 30,
    "max_drawdown": 0.10,
    "min_profit_factor": 1.10,
    "max_bootstrap_pvalue": 0.10,
    "fdr_q": 0.10,
    "min_active_folds": 2,
    "min_positive_fold_fraction": 0.50,
    "cost_stress_multipliers": [1.5, 2.0],
    "min_shadow_runs": 24,
    "min_shadow_pair_fills": 20,
    "max_one_sided_fill_rate": 0.25,
    "min_incremental_utility": 0.0,
    "min_consecutive_passes": 3
  },
  "coordination": {
    "max_dispatches_per_cycle": 4,
    "dispatch_cooldown_seconds": 900,
    "workflows": {
      "ci.yml": {"name":"ci","requires_current_main":true,"max_age_seconds":0,"dispatchable":true,"priority":10,"dependencies":[]},
      "monitoring.yml": {"name":"monitoring","requires_current_main":true,"max_age_seconds":0,"dispatchable":true,"priority":20,"dependencies":[]},
      "v4-live-smoke.yml": {"name":"v4-live-paper-smoke","requires_current_main":true,"max_age_seconds":7200,"dispatchable":true,"priority":30,"dependencies":["ci.yml","monitoring.yml"]},
      "forward-maker-research.yml": {"name":"forward-maker-alpha-research","requires_current_main":true,"max_age_seconds":5400,"dispatchable":true,"priority":40,"dependencies":["ci.yml"]},
      "alpha-factory.yml": {"name":"Polymarket Alpha Factory","requires_current_main":true,"max_age_seconds":10800,"dispatchable":true,"priority":50,"dependencies":["v4-live-smoke.yml","forward-maker-research.yml"]},
      "research-queue.yml": {"name":"Polymarket Research Director","requires_current_main":true,"max_age_seconds":5400,"dispatchable":true,"priority":55,"dependencies":["alpha-factory.yml"]},
      "research-policy.yml": {"name":"Polymarket Research Policy","requires_current_main":true,"max_age_seconds":7200,"dispatchable":true,"priority":60,"dependencies":["ci.yml"]},
      "promotion-controller.yml": {"name":"Polymarket Promotion Controller","requires_current_main":true,"max_age_seconds":1800,"dispatchable":true,"priority":65,"dependencies":["ci.yml","monitoring.yml","v4-live-smoke.yml","research-policy.yml","alpha-factory.yml"]},
      "server-health.yml": {"name":"paper-server-health","requires_current_main":false,"max_age_seconds":7200,"dispatchable":false,"priority":70,"dependencies":[]},
      "deploy-paper-server.yml": {"name":"deploy-paper-server","requires_current_main":false,"max_age_seconds":0,"dispatchable":false,"priority":80,"dependencies":["v4-live-smoke.yml"],"ignore_scheduled_skips":true}
    },
    "allowlisted_dispatches": [
      "ci.yml","monitoring.yml","v4-live-smoke.yml","forward-maker-research.yml","alpha-factory.yml","research-queue.yml","research-policy.yml","promotion-controller.yml"
    ],
    "forbidden_dispatches": ["integration-merge.yml","deploy-paper-server.yml","server-health.yml"]
  }
}
