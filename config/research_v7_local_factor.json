{
  "schema_version": 1,
  "paper_only": true,
  "research_only": true,
  "live_intents_enabled": false,
  "universe": {
    "maximum_markets": 1000,
    "minimum_liquidity_usd": 2.0,
    "maximum_clusters": 40
  },
  "history": {
    "lookback_hours": 720,
    "fidelity_minutes": 30,
    "minimum_regular_common_points": 48,
    "require_regular_common_suffix": true,
    "allow_irregular_transition_as_one_bar": false
  },
  "inference": {
    "minimum_pair_controls": 2,
    "bootstrap_repetitions": 300,
    "bootstrap_type": "joint_panel_increment_blocks_reestimate_full_pair_factor",
    "pair_test_statistic": "max_of_two_adf_t_statistics",
    "bh_fdr": 0.10,
    "apply_bh_before_residual_z_phi_and_economic_filters": true,
    "minimum_abs_residual_z_after_bh": 0.75
  },
  "forecast": {
    "mean_reversion": "phi_power_h",
    "maximum_hold_hours": 24,
    "time_to_resolution_exit_buffer_seconds": 3600
  },
  "hedge": {
    "common_basis": "leave_both_targets_out",
    "price_pnl_exposure": "side_sign*p*(1-p)*yes_logit_sd*common_basis_loading",
    "minimum_weight": 0.05,
    "maximum_weight": 10.0
  },
  "execution_evidence": {
    "require_received_ms_point_in_time_tape": true,
    "require_active_flow_eligibility": true,
    "require_joint_fill_state_bitmasks": true,
    "states": ["both", "a_only", "b_only", "none"],
    "require_partial_state_abort_unwind_pnl": true,
    "minimum_joint_state_observations": 100,
    "cost_stress_multipliers": [1.0, 1.5, 2.0],
    "marginal_fill_product_is_joint_estimator": false,
    "minimum_marginal_fill_is_joint_estimator": false
  },
  "promotion_gate": {
    "require_valid_bh_survivors": true,
    "require_common_pair_factor_basis": true,
    "require_price_pnl_hedge_units": true,
    "require_joint_completion_positive_ev": true,
    "require_positive_fill_conditioned_pnl_under_cost_stress": true,
    "require_shared_execution_ledger": true
  }
}
