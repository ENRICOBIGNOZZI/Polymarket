{
  "authenticated_execution": false,
  "execution_mode": "PAPER_SIMULATED",
  "execution_modes_policy": "config/v7_execution_modes.json",
  "failure_domains": {
    "cancel_pending_reconnect": {
      "action": "hold_withdrawn_until_reconciled",
      "critical": false,
      "scope": "affected_market"
    },
    "clock_jump": {
      "action": "withdraw_and_quarantine",
      "critical": true,
      "scope": "runtime"
    },
    "disk_pressure_critical": {
      "action": "withdraw_and_quarantine",
      "critical": true,
      "scope": "runtime"
    },
    "dns": {
      "action": "isolate_and_retry",
      "critical": false,
      "scope": "dependent_feed"
    },
    "duplicate_update": {
      "action": "deduplicate",
      "critical": false,
      "scope": "affected_market"
    },
    "external_feed": {
      "action": "quarantine",
      "critical": false,
      "scope": "dependent_sleeves"
    },
    "http_timeout": {
      "action": "isolate_and_retry",
      "critical": false,
      "scope": "dependent_feed"
    },
    "ledger_write": {
      "action": "withdraw_and_quarantine",
      "critical": true,
      "scope": "runtime"
    },
    "market_ws": {
      "action": "withdraw_and_restart",
      "critical": true,
      "scope": "runtime"
    },
    "monitoring": {
      "action": "restart_monitoring_only",
      "critical": false,
      "scope": "monitoring"
    },
    "oracle_unknown": {
      "action": "quarantine",
      "critical": false,
      "scope": "affected_contracts"
    },
    "out_of_order_update": {
      "action": "reject_and_resnapshot",
      "critical": false,
      "scope": "affected_market"
    },
    "rest_stale": {
      "action": "quarantine",
      "critical": false,
      "scope": "dependent_sleeves"
    },
    "sequence_gap": {
      "action": "invalidate_book_and_resnapshot",
      "critical": false,
      "scope": "affected_market"
    },
    "pure_arb_taker_delay_pending": {
      "action": "hold_non_cancelable_until_arrival",
      "critical": false,
      "scope": "affected_order"
    },
    "pure_arb_one_leg_failure": {
      "action": "unwind_and_quarantine_market",
      "critical": false,
      "scope": "affected_market"
    },
    "market_semantic_change": {
      "action": "cancel_reset_and_rebuild",
      "critical": false,
      "scope": "affected_market"
    },
    "venue_degraded": {
      "action": "no_new_risk_cancel_only",
      "critical": false,
      "scope": "runtime"
    },
    "venue_cancel_only": {
      "action": "no_new_risk_cancel_only",
      "critical": false,
      "scope": "runtime"
    },
    "deep_snapshot_truncated": {
      "action": "reject_opportunity_and_resnapshot",
      "critical": false,
      "scope": "affected_market"
    },
    "fee_semantics_unknown": {
      "action": "quarantine_taker",
      "critical": false,
      "scope": "affected_market"
    },
    "pure_arb_clob_reject": {
      "action": "unwind_filled_legs_and_quarantine_market",
      "critical": false,
      "scope": "affected_market"
    },
    "pure_arb_asymmetric_book_stale": {
      "action": "reject_opportunity_and_resnapshot",
      "critical": false,
      "scope": "affected_market"
    },
    "market_fee_change": {
      "action": "cancel_reset_and_rebuild",
      "critical": false,
      "scope": "affected_market"
    },
    "market_rollover_with_open_order": {
      "action": "hold_withdrawn_until_reconciled",
      "critical": false,
      "scope": "affected_market"
    },
    "market_book_reset": {
      "action": "invalidate_book_and_resnapshot",
      "critical": false,
      "scope": "affected_market"
    },
    "disk_io_stall": {
      "action": "withdraw_and_quarantine",
      "critical": true,
      "scope": "runtime"
    },
    "cpu_stall": {
      "action": "withdraw_and_quarantine",
      "critical": true,
      "scope": "runtime"
    }
  },
  "identity": {
    "require_exact_40_character_sha": true,
    "require_repository_head_match": true,
    "require_runtime_sha_match": true,
    "single_writer_lock": "control/runtime.lock/pid",
    "supervisor_lock": "control/supervisor.lock"
  },
  "paper_only": true,
  "real_capital_at_risk": false,
  "real_order_submission": false,
  "reconciliation": {
    "kill_marker": "control/KILL",
    "ledger": "ledger/execution.jsonl",
    "lineage_epoch": "control/feed_lineage_epoch.json",
    "never_restart_killed_or_unsafe_state": true,
    "portfolio": "control/portfolio_state.json",
    "reject_mixed_sha": true,
    "reject_unsafe_paper_inventory": true,
    "require_complete_ledger_lines": true,
    "runtime_status": "control/runtime_status.json"
  },
  "schema": "polymarket_v7_runtime_supervision_v1",
  "service": {
    "command": [
      "bash",
      "scripts/paper_v7_execution_loop.sh"
    ],
    "health_interval_seconds": 5,
    "restart": {
      "backoff_seconds": [
        1,
        2,
        5,
        15,
        30
      ],
      "maximum_attempts": 5,
      "window_seconds": 900
    },
    "runtime_stale_seconds": 30,
    "startup_grace_seconds": 420,
    "termination_grace_seconds": 15
  },
  "version": 7
}
