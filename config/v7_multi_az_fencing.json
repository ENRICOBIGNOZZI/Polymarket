{
  "schema": "polymarket_v7_multi_az_fencing_v1",
  "version": 1,
  "paper_only": true,
  "authenticated_execution": false,
  "real_order_submission": false,
  "provider": "AWS_DYNAMODB",
  "region": "eu-west-2",
  "lease_key": "polymarket-v7-paper",
  "lease_ttl_seconds": 15,
  "renew_interval_seconds": 5,
  "minimum_remaining_lease_seconds": 5,
  "fencing_token_policy": "STRICTLY_MONOTONIC_ON_SUCCESSFUL_WRITE",
  "split_brain_policy": "FAIL_CLOSED",
  "stale_receipt_policy": "KILL_RUNTIME_WHEN_REQUIRED",
  "required_environment": [
    "PM_V7_FENCING_TABLE",
    "PM_V7_SERVER_ID"
  ]
}
