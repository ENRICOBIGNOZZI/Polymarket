{
  "schema": "polymarket_v7_crypto_execution_alpha_config_v1",
  "version": 1,
  "paper_only": true,
  "authenticated_execution": false,
  "real_order_submission": false,
  "real_capital_at_risk": false,
  "automatic_promotion": false,
  "decision_owner": "CRYPTO_SETTLEMENT_ENGINE",
  "action_space": ["MAKE", "TAKE", "CANCEL", "WITHDRAW", "NOTHING"],
  "objective": "MAX_CONSERVATIVE_EXPECTED_CHANGE_IN_ACCOUNT_WEALTH",
  "risk_actions_preempt_alpha": true,
  "minimum_positive_conservative_ev_usd": 0.0,
  "execution_alpha": {
    "required_feature_groups": [
      "queue_ahead",
      "spread",
      "book_imbalance",
      "recent_aggressive_flow",
      "quote_lifetime_ms",
      "tte_seconds",
      "binance_shock_bp",
      "coinbase_shock_bp",
      "bybit_shock_bp",
      "cross_venue_disagreement_bp",
      "oracle_distance_bp",
      "volatility_bp",
      "latency_ms"
    ],
    "maker": {
      "fill_probability_source": "V7_MAKER_EXECUTION_MODEL",
      "markout_source": "FILL_CONDITIONED_CAUSAL_MARKOUT",
      "toxic_fill_source": "EXTERNAL_CANCEL_FORWARD_PLUS_MAKER_MARKOUT",
      "formula": "P_fill_lower*(spread_capture+settlement_edge+markout_lower)-inventory_cost-unwind_cost-cancel_latency_cost"
    },
    "taker": {
      "formula": "settlement_edge_lower-fee-slippage-latency_cost-adverse_selection_cost",
      "arrival_revalidation_required": true,
      "visible_depth_bound_required": true
    },
    "cancel": {
      "formula": "avoided_toxic_fill_loss_lower-cancel_cost",
      "external_cancel_overlay_experiment_id": "btc-m5-external-cancel-overlay-forward-v1",
      "promotion_requires_frozen_forward_gate": true
    },
    "nothing_ev_usd": 0.0
  },
  "market_selection": {
    "enabled": true,
    "minimum_candidate_markets": 2,
    "top_fraction": 0.25,
    "minimum_markets_retained": 1,
    "score_weights": {
      "predictability": 0.14,
      "mispricing": 0.22,
      "spread_capture": 0.10,
      "depth": 0.08,
      "flow": 0.08,
      "latency": 0.08,
      "tte": 0.08,
      "fillability": 0.12,
      "adverse_selection": 0.10
    },
    "score_semantics": "BOUNDED_MONOTONE_COMPONENTS_NO_TRAINED_WEIGHTS_UNTIL_FORWARD_EVIDENCE",
    "capital_and_quote_budget": "RETAINED_MARKETS_ONLY"
  },
  "paper_exploration": {
    "enabled": true,
    "authority": "PAPER_EXPLORATION",
    "promotion_credit": false,
    "minimum_size_only": true,
    "assignment_before_outcome_required": true,
    "strata": [
      "queue_bucket",
      "spread_bucket",
      "tte_bucket",
      "volatility_bucket",
      "activity_bucket",
      "quote_lifetime_bucket"
    ],
    "information_gain_priority": [
      "fill_probability_uncertainty",
      "toxic_fill_probability_uncertainty",
      "markout_uncertainty",
      "queue_depletion_uncertainty"
    ]
  },
  "pnl_attribution": {
    "required": true,
    "components": [
      "settlement_alpha",
      "spread_capture",
      "rebates_rewards",
      "adverse_selection",
      "fees",
      "slippage",
      "latency",
      "inventory",
      "unwind",
      "other"
    ],
    "identity": "realized_pnl=sum(components)"
  }
}
