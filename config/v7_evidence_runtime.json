{
  "schema_version": 2,
  "paper_only": true,
  "authenticated_execution": false,
  "source_selection": {
    "mode": "single_open_canonical_integration_pr",
    "base_branch": "main",
    "head_prefix": "integration/v7-",
    "require_open": true,
    "require_current_main_ancestor": true,
    "manual_source_pr_must_match_same_contract": true
  },
  "candidate_contract": {
    "require_enabled_v7_champion": true,
    "champion_loop": "scripts/paper_v7_execution_loop.sh",
    "champion_config": "config/paper_v7.json",
    "champion_run_root": "runs/paper_v7_live",
    "require_operator_directives_match_main": true,
    "require_paper_only": true,
    "require_authenticated_execution_false": true,
    "require_authoritative_fee": true,
    "require_shared_execution_ledger": true,
    "require_single_canonical_ledger_writer": true,
    "require_joint_fill_state_for_multileg": true,
    "require_complete_cost_vector": true,
    "require_account_drawdown_guard": true,
    "max_drawdown": 0.15
  },
  "runtime_root": "runs/v7_candidate_evidence",
  "proxy_port": 9130,
  "required_successful_workflows": [
    "ci",
    "Polymarket Research Policy",
    "monitoring",
    "Private runtime single-writer validation"
  ],
  "state_partition": "source_head_sha",
  "restart_on_source_head_change": true,
  "publish_telemetry": true,
  "telemetry_latest_path": "telemetry/latest-v7-unified-evidence.json",
  "telemetry_runtime_path": "telemetry/latest-v7-unified-runtime.json",
  "rule": "Run only the single open canonical integration/v7-* PR whose exact head descends from current main, has all required exact-head workflows green, and contains the enabled PAPER-only V7 candidate champion. The isolated per-SHA runtime uses the canonical single-writer ledger and bundle-level economics; it never mutates main, paper-validated, deploy state, authenticated execution, or another runtime."
}
