{
  "schema_version": 1,
  "paper_only": true,
  "allow_authenticated_execution": false,
  "allow_direct_champion_mutation": false,
  "max_dispatches_per_cycle": 2,
  "alpha_factory_max_age_seconds": 10800,
  "stagnation_seconds": 7200,
  "owner_workflows": {
    "forward-maker-research.yml": {
      "workflow_name": "forward-maker-alpha-research",
      "description": "Prospective V7 maker queue/fill/markout research"
    },
    "external-intelligence.yml": {
      "workflow_name": "Polymarket External Intelligence",
      "description": "Chronological public external-information research"
    },
    "fast-arb-hourly.yml": {
      "workflow_name": "Fast Arbitrage Hourly Shadow",
      "description": "V7 hard-arbitrage freshness/depth/fee/legging evidence"
    },
    "arb-theory-hourly.yml": {
      "workflow_name": "Arbitrage Theory Hourly Research",
      "description": "V7 Graph/relative-value structural research"
    }
  },
  "owner_remap": {},
  "experiment_prefix_owner": {
    "maker_": "forward-maker-research.yml",
    "execution_": "forward-maker-research.yml",
    "external_": "external-intelligence.yml",
    "hard_arb_": "fast-arb-hourly.yml",
    "graph_": "arb-theory-hourly.yml",
    "relative_value_": "arb-theory-hourly.yml"
  },
  "owner_cooldowns_seconds": {
    "forward-maker-research.yml": 1800,
    "external-intelligence.yml": 3600,
    "fast-arb-hourly.yml": 3600,
    "arb-theory-hourly.yml": 3600
  },
  "forbidden_workflows": [
    "integration-merge.yml",
    "promotion-controller.yml",
    "post-merge-validation.yml",
    "deploy-paper-server.yml",
    "server-health.yml",
    "v7-live-paper-validation.yml"
