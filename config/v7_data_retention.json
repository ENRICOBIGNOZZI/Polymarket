{
  "schema": "polymarket_v7_data_retention_v1",
  "version": 8,
  "paper_only": true,
  "disk": {
    "warning_free_ratio": 0.2,
    "critical_free_ratio": 0.04,
    "minimum_free_bytes": 5368709120
  },
  "canonical_ledger": {
    "path": "ledger/execution.jsonl",
    "mode": "immutable_checkpoint_never_delete",
    "archive_directory": "archive/canonical-ledger",
    "checkpoint_interval_seconds": 3600,
    "retain_local_checkpoints": 168,
    "durable_archive_required_before_local_prune": true
  },
  "cutover_archives": {
    "directory_name": "paper_v7_archives",
    "keep_full_generations": 3,
    "canonical_ledgers": "verified_gzip_never_delete",
    "remove_only": "NONE_WITHOUT_REPRODUCIBILITY_PROOF"
  },
  "streams": [
    {
      "name": "ws_tape",
      "patterns": [
        "market_data/*.csv.*",
        "market_data/*.jsonl.*"
      ],
      "retention_days": 7,
      "retention_semantics": "PERMANENT_VERIFIED_COMPRESSION_NO_EXPIRY"
    },
    {
      "name": "trade_tape",
      "patterns": [
        "trade_tape.csv.*"
      ],
      "retention_days": 30,
      "retention_semantics": "PERMANENT_VERIFIED_COMPRESSION_NO_EXPIRY"
    },
    {
      "name": "latency_telemetry",
      "patterns": [
        "micro_maker/latency.csv.*"
      ],
      "retention_days": 14,
      "retention_semantics": "PERMANENT_VERIFIED_COMPRESSION_NO_EXPIRY"
    },
    {
      "name": "external_events",
      "patterns": [
        "external/*.csv.*",
        "external/*.jsonl.*",
        "external_fair/*.jsonl.*"
      ],
      "retention_days": 30,
      "retention_semantics": "PERMANENT_VERIFIED_COMPRESSION_NO_EXPIRY"
    },
    {
      "name": "runtime_logs",
      "patterns": [
        "**/*.log.*",
        "**/*.log.gz"
      ],
      "retention_days": 14,
      "retention_semantics": "PERMANENT_VERIFIED_COMPRESSION_NO_EXPIRY"
    }
  ],
  "active_files": {
    "diagnostic_log_max_bytes": 104857600,
    "diagnostic_log_generations": 10,
    "append_reopen_max_bytes": 104857600,
    "append_reopen_streams": [
      "external_fair/rtds_events.jsonl"
    ],
    "never_copytruncate": [
      "ledger/execution.jsonl",
      "trade_tape.csv",
      "micro_maker/latency.csv"
    ]
  },
  "permanent_evidence": {
    "unique_source_deletion": "ONLY_ALLOWLISTED_CLOSED_EXTERNAL_TAPES_AFTER_VERIFIED_AGGREGATION",
    "model_independent_survival": true,
    "compression_requires_decompressed_hash_verification": true,
    "derived_discard_requires_exact_source_provenance": true,
    "maximum_total_data_bytes": 30000000000,
    "budget_unit": "DECIMAL_GB_ALL_MANAGED_DATA_INCLUDING_LIVE_ARCHIVES_AND_PERMANENT_STORE",
    "target_compaction_bytes": 24000000000,
    "warning_bytes": 25000000000,
    "critical_bytes": 28000000000,
    "external_storage_allowed": false,
    "information_loss_allowed": true,
    "compression_policy": "LOSSLESS_FIRST; EXPLICIT_VERIFIED_LOSSY_OLDER_EXTERNAL_TAPE_AGGREGATES",
    "budget_exhaustion_policy": "CONTINUE_COLLECTION; AGGREGATE_OLDER_ALLOWLISTED_DETAIL; SURFACE_UNCOVERED_PRODUCER_CAPACITY"
  },
  "aggregate_retention": {
    "enabled": true,
    "authorization": "USER_AUTHORIZED_CONTINUOUS_COLLECTION_WITH_OLDER_DETAIL_AGGREGATED_20260909",
    "target_bytes": 24000000000,
    "trigger_bytes": 25000000000,
    "minimum_age_seconds": 3600,
    "maximum_seconds_per_pass": 240,
    "hard_filesystem_quota": false,
    "scope": "CLOSED_EXTERNAL_RAW_AND_NORMALIZED_TAPES_ONLY",
    "protected": "LEDGERS_DECISIONS_OUTCOMES_PM_BOOKS_AND_ALL_NON_ALLOWLISTED_SOURCES"
  }
}
