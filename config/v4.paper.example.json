  "rv_z_threshold": 2.0,
  "rv_min_mr_probability": 0.68,
  "rv_reversion_strength": 0.30,
  "history_window": 240,
  "rv_min_history": 24,

  "maker_enabled": true,
  "maker_min_expected_edge": 0.0005,
  "maker_rebate_per_share": 0.0,
  "maker_liquidity_reward_per_share": 0.0,
  "maker_horizon_seconds": 60.0,
  "maker_min_fill_probability": 0.05,
  "maker_latency_ms": 250,
  "maker_max_order_usd": 50.0,

  "taker_slippage_bps": 5.0,
  "uncertainty_penalty": 0.20,
  "scan_only": false
}
