  "max_mid": 0.995,
  "max_spread": 0.20,

  "max_trade_usd": 100.0,
  "max_market_fraction": 0.02,
  "max_event_fraction": 0.06,
  "max_gross_fraction": 0.20,
  "max_drawdown": 0.15,

  "structural_min_edge": 0.0025,
  "structural_completeness_tolerance": 0.08,

  "terminal_min_edge": 0.0125,
  "terminal_min_confidence": 0.55,

