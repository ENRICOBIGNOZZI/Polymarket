{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymarket.local/schemas/v7-oracle-binding-v1.json",
  "title": "V7 verified Chainlink Data Streams binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "feed_id",
    "price_decimals",
    "oracle_window_seconds",
    "resolution_source",
    "mapping_version",
    "mapping_sha"
  ],
  "properties": {
    "feed_id": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
    "price_decimals": {"type": "integer", "minimum": 0, "maximum": 30},
    "oracle_window_seconds": {"type": "integer", "minimum": 1},
    "resolution_source": {
      "type": "string",
      "pattern": "^https://(www\\.)?data\\.chain\\.link/streams/"
    },
    "mapping_version": {"type": "string", "minLength": 1},
    "mapping_sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "description": "No default feed is shipped: feed id, decimals and rule source must be approved together. mapping_sha is the canonical hash verified by scripts/v7_same_oracle_adapter.py."
}
