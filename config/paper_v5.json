          "backend": "negrisk_basket_scan",
          "entry_enabled": false,
          "target": "complete_event_basket",
          "reason": "a probability-sum constraint identifies a basket, not a single directional leg"
        },
        "semantic": {
          "backend": "shadow_only",
          "entry_enabled": false,
          "target": "relation_conditioned_relative_value",
          "reason": "polarity, threshold, horizon and event relation are not identified"
        },
        "external": {
          "backend": "shadow_only",
          "entry_enabled": false,
          "target": "terminal_probability",
          "reason": "no fresh approved terminal-probability feed is configured"
        }
      }
