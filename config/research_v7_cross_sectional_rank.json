{
  "schema_version": 1,
  "paper_only": true,
  "research_only": true,
  "live_intents_enabled": false,
  "target": "cross_sectional_fixed_horizon_logit_markout",
  "horizons_minutes": [30, 60, 120, 360],
  "history": {
    "lookback_hours": 720,
    "fidelity_minutes": 30,
    "minimum_cross_section": 20,
    "minimum_group_size": 5,
    "group_neutralization_weight": 0.5,
    "purge_embargo_buckets": 1,
    "training_window_days": 21,
    "recency_half_life_days": 7
  },
  "model": {
    "type": "cross_sectionally_normalized_ridge",
    "ridge_penalty": 0.05,
    "features": [
      "mom_1",
      "mom_2",
      "mom_4",
      "mom_12",
      "mean_gap_4",
      "mean_gap_12",
      "accel_4",
      "vol_4",
      "vol_12",
      "level_abs"
    ],
    "feature_winsorization_z": 5.0,
    "minimum_training_rows": 500,
    "minimum_training_cross_sections": 40
  },
  "oos_gate": {
    "minimum_test_cross_sections": 40,
    "minimum_predictions": 500,
    "minimum_median_rank_ic": 0.02,
    "minimum_positive_ic_fraction": 0.55,
    "minimum_decile_monotonicity": 0.50,
    "require_positive_top_bottom_spread": true,
    "require_execution_ledger_validation_before_integration": true
  },
  "execution_shadow": {
    "mode": "TAKER",
    "minimum_net_edge": 0.00005,
    "minimum_liquidity_usd": 2.0,
    "maximum_spread": 0.25,
    "slippage_bps_round_trip_leg": 5.0,
    "capital_cost_bps_per_hour": 0.25,
    "adverse_markout_penalty_bps": 2.0,
    "maximum_book_age_seconds": 30,
    "maximum_positions_per_side": 10,
    "maximum_trade_usd": 60.0,
    "shadow_sleeve_budget_usd": 600.0,
    "one_contract_per_event": true,
    "binary_kelly": false
  },
  "integration_contract": {
    "single_leg_only": true,
    "bottom_rank_action": "BUY_NO",
    "top_rank_action": "BUY_YES",
    "terminal_probability_interpretation": false,
    "requires_authoritative_market_fee": true,
    "requires_fresh_executable_book": true,
    "requires_shared_v6_v7_broker_ledger": true,
    "direct_authenticated_execution": false
  }
}
