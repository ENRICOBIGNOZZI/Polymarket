{
  "schema_version": 1,
  "repository": "ENRICOBIGNOZZI/Polymarket",
  "canonical_branch": "main",
  "deployment_ref": "paper-validated",
  "live_champion_manifest": "config/live_champion.json",
  "model_architecture_manifest": null,
  "scheduler_registry": "config/scheduler_registry.json",
  "operator_directives": "config/operator_directives.json",
  "context_policy": {
    "scope": "entire_repository",
    "require_full_worktree_inventory": true,
    "require_operator_directives": true,
    "inventory_command": "git ls-files",
    "rule": "The repository is in an explicitly authorized no-champion V7 transition. V3-V6 runtime surfaces are retired and must not be restored for compatibility."
  },
  "required_surfaces": [
    ".github/workflows",
    "config",
    "docs",
    "include",
    "ops",
    "scripts",
    "src",
    "tests",
    "CMakeLists.txt",
    "README.md"
  ],
  "runtime": {
    "host_alias": "polymarket",
    "host": "100.104.183.109",
    "user": "enrico",
    "port": 22,
    "remote_root": "~/polymarket",
    "ssh_config_source": "ops/ssh_config_polymarket",
    "active_champion": false
  },
  "grafana": {
    "canonical_operator_url": "http://mamma-portfolio.tail1bae85.ts.net",
    "active": false,
    "dashboard_uid": null,
    "dashboard_file": null,
    "rule": "No champion-specific dashboard is canonical while the operational champion is disabled. V7 may install a new dashboard only with its validated integration."
  },
  "security": {
    "private_keys_in_repository": false,
    "authenticated_real_money_execution": false,
    "rule": "SSH private keys and other credentials must remain outside version control."
  }
}
