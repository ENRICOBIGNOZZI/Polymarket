{
  "schema": "polymarket_v7_process_manifest_v1",
  "version": 1,
  "paper_only": true,
  "authenticated_execution": false,
  "real_order_submission": false,
  "real_capital_at_risk": false,
  "authority_registry": "config/v7_authority_registry.json",
  "launcher": "scripts/paper_v7_execution_loop.sh",
  "expected_process_count": 10,
  "expected_launcher_child_count": 9,
  "profiles": {
    "core": {
      "archival_behavior": "EXACT_SHA_ATOMIC_ARCHIVE",
      "authority_flags": {
        "capital_allocator": false,
        "global_portfolio_coordinator": false,
        "inventory": false,
        "ledger": false,
        "oms": false,
        "risk_engine": false,
        "runtime_identity": false
      },
      "drain_behavior": "DRAIN_AND_CONFIRM_TERMINAL_STATE",
      "fault_domain": "ECONOMIC_CORE",
      "freshness_slo_seconds": 5,
      "liveness_slo_seconds": 5,
      "owner_class": "CANONICAL_CORE",
      "restart_policy": "FAIL_CLOSED_WHOLE_RUNTIME"
    },
    "engine": {
      "archival_behavior": "EXACT_SHA_ATOMIC_ARCHIVE",
      "authority_flags": {
        "capital_allocator": false,
        "global_portfolio_coordinator": false,
        "inventory": false,
        "ledger": false,
        "oms": false,
        "risk_engine": false,
        "runtime_identity": false
      },
      "drain_behavior": "STOP_NEW_PROPOSALS_AND_DRAIN_OBSERVATIONS",
      "fault_domain": "LIVE_ALGORITHM",
      "freshness_slo_seconds": 5,
      "liveness_slo_seconds": 5,
      "owner_class": "LIVE_ALGORITHM_COMPONENT",
      "restart_policy": "FAIL_CLOSED_ENGINE_INPUT"
    },
    "feed": {
      "archival_behavior": "EXACT_SHA_ATOMIC_ARCHIVE",
      "authority_flags": {
        "capital_allocator": false,
        "global_portfolio_coordinator": false,
        "inventory": false,
        "ledger": false,
        "oms": false,
        "risk_engine": false,
        "runtime_identity": false
      },
      "drain_behavior": "STOP_WITHOUT_INVENTORY",
      "fault_domain": "DATA_FEED",
      "freshness_slo_seconds": 120,
      "liveness_slo_seconds": 30,
      "owner_class": "LIVE_ALGORITHM_DATA_FEED",
      "restart_policy": "FAIL_CLOSED_ENGINE_INPUT"
    },
    "infrastructure": {
      "archival_behavior": "EXACT_SHA_ATOMIC_ARCHIVE",
      "authority_flags": {
        "capital_allocator": false,
        "global_portfolio_coordinator": false,
        "inventory": false,
        "ledger": false,
        "oms": false,
        "risk_engine": false,
        "runtime_identity": false
      },
      "drain_behavior": "STOP_AFTER_DEPENDENTS",
      "fault_domain": "INFRASTRUCTURE",
      "freshness_slo_seconds": 5,
      "liveness_slo_seconds": 5,
      "owner_class": "RUNTIME_INFRASTRUCTURE",
      "restart_policy": "FAIL_CLOSED_DEPENDENTS"
    },
    "observer": {
      "archival_behavior": "EXACT_SHA_ATOMIC_ARCHIVE",
      "authority_flags": {
        "capital_allocator": false,
        "global_portfolio_coordinator": false,
        "inventory": false,
        "ledger": false,
        "oms": false,
        "risk_engine": false,
        "runtime_identity": false
      },
      "drain_behavior": "STOP_WITHOUT_INVENTORY",
      "fault_domain": "OBSERVABILITY",
      "freshness_slo_seconds": 120,
      "liveness_slo_seconds": 30,
      "owner_class": "LIVE_ALGORITHM_OBSERVER",
      "restart_policy": "RESTART_ISOLATED_WITH_BACKOFF"
    }
  },
  "processes": [
    {
      "id": "public_https_proxy",
      "executable": "scripts/v7_public_https_proxy.py",
      "arguments": [
        "--host",
        "127.0.0.1",
        "--port",
        "${PUBLIC_PROXY_PORT}"
      ],
      "profile": "infrastructure",
      "inputs": [],
      "outputs": [
        "public_https_proxy.log"
      ],
      "dependencies": [],
      "exact_sha_required": true,
      "config_identity_required": false,
      "launcher_log": "public_https_proxy.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "crypto_universe",
      "executable": "scripts/v7_crypto_universe.py",
      "arguments": [
        "--loop",
        "--model-sha",
        "${SHA}"
      ],
      "profile": "infrastructure",
      "inputs": [
        "config/v7_crypto_universe.json"
      ],
      "outputs": [
        "universe/current.json",
        "universe/status.json",
        "universe/collector.log"
      ],
      "dependencies": [
        "public_https_proxy"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "universe/collector.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "trade_recorder",
      "executable": "${RECORDER}",
      "arguments": [
        "--universe",
        "${RUN_ROOT}/universe/current.json",
        "--model-sha",
        "${SHA}",
        "--loop"
      ],
      "profile": "observer",
      "inputs": [
        "universe/current.json"
      ],
      "outputs": [
        "trade_tape.csv",
        "trade_recorder_status.json",
        "trade_recorder.log"
      ],
      "dependencies": [
        "crypto_universe",
        "public_https_proxy"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "trade_recorder.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "external_venue_evidence",
      "executable": "scripts/v7_multi_asset_external_collector.py",
      "arguments": [
        "--model-sha",
        "${SHA}",
        "--engine",
        "${EXTERNAL_VENUE_RUNTIME}",
        "--market-registry",
        "${ROOT}/config/v7_crypto_settlement_markets.json"
      ],
      "profile": "feed",
      "inputs": [
        "config/v7_crypto_settlement_markets.json"
      ],
      "outputs": [
        "external_fair/all_assets_status.json",
        "external_fair/external_venues.json",
        "external_fair/tapes",
        "external_fair/raw",
        "external_fair/normalized_events",
        "external_fair/assets",
        "external_fair/external_assets_supervisor.log"
      ],
      "dependencies": [
        "public_https_proxy"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "external_fair/external_assets_supervisor.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "rtds_monitor",
      "executable": "scripts/v7_rtds_external_fair_monitor.py",
      "arguments": [],
      "profile": "observer",
      "inputs": [
        "universe/current.json",
        "external_fair/external_venues.json"
      ],
      "outputs": [
        "external_fair/status.json",
        "external_fair/rtds_monitor.log"
      ],
      "dependencies": [
        "crypto_universe",
        "external_venue_evidence"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "external_fair/rtds_monitor.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "pm_book_observer",
      "executable": "${FILLABILITY_OBSERVER}",
      "arguments": [
        "--selection",
        "${RUN_ROOT}/universe/book_selection.json",
        "--selection-only",
        "--model-sha",
        "${SHA}"
      ],
      "profile": "observer",
      "inputs": [
        "universe/current.json",
        "universe/book_selection.json"
      ],
      "outputs": [
        "research/repricing_book/fillability_ws_status.json",
        "research/repricing_book/book_observations/current.jsonl",
        "research/repricing_book_observer.log"
      ],
      "dependencies": [
        "crypto_universe"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "research/repricing_book_observer.log",
      "london_deployed": true,
      "runtime_class": "COLLECTOR"
    },
    {
      "id": "ledger_router",
      "executable": "scripts/v7_ledger_spool.py",
      "arguments": [
        "--loop",
        "--model-sha",
        "${SHA}"
      ],
      "profile": "core",
      "inputs": [
        "ledger/spool"
      ],
      "outputs": [
        "ledger/execution.jsonl",
        "ledger_router.log"
      ],
      "dependencies": [],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "ledger_router.log",
      "london_deployed": true,
      "runtime_class": "CONTROL",
      "authority_overrides": {
        "ledger": true
      }
    },
    {
      "id": "native_engine_manager",
      "executable": "scripts/v7_native_crypto_engine_manager.py",
      "arguments": [
        "--repository-root",
        "${ROOT}",
        "--run-root",
        "${RUN_ROOT}",
        "--model-sha",
        "${SHA}",
        "--run-id",
        "${RUN_ID}",
        "--server-id",
        "${SERVER_ID}",
        "--universe",
        "${RUN_ROOT}/universe/current.json",
        "--engine",
        "${CRYPTO_SETTLEMENT_ENGINE}",
        "--settler",
        "${ROOT}/scripts/v7_native_paper_settlement.py",
        "--engine-log",
        "${RUN_ROOT}/native_crypto_settlement_engine.log",
        "--allocation",
        "${RUN_ROOT}/control/allocations/crypto_settlement_engine.json",
        "--market-registry",
        "${ROOT}/config/v7_crypto_settlement_markets.json",
        "--signal-policy",
        "${ROOT}/config/v7_crypto_signal_policy.json",
        "--legacy-claims",
        "${RUN_ROOT}/control/legacy_native_claims.json",
        "--target-quantity-microunits",
        "5000000",
        "--maximum-entry-price-e4",
        "7500",
        "--minimum-tte-ns",
        "105000000000",
        "--maximum-tte-ns",
        "120000000000",
        "--maker-share-cap-microunits",
        "1000000",
        "--asynchronous-settlement",
        "--capture-native-decisions",
        "--capture-execution-windows",
        "--execution-window-ns",
        "2000000000",
        "--capture-native-full-context",
        "BTC:M5"
      ],
      "profile": "core",
      "inputs": [
        "universe/current.json",
        "ledger/execution.jsonl",
        "control/allocations/manifest.json",
        "control/allocations/crypto_settlement_engine.json",
        "config/v7_crypto_settlement_markets.json",
        "config/v7_native_risk_policy.json",
        "control/legacy_native_claims.json",
        "config/v7_crypto_signal_policy.json"
      ],
      "outputs": [
        "control/native_engine_manager_status.json",
        "native_engine_manager.log"
      ],
      "dependencies": [
        "crypto_universe",
        "ledger_router"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "native_engine_manager.log",
      "london_deployed": true,
      "runtime_class": "CONTROL"
    },
    {
      "id": "crypto_settlement_engine",
      "executable": "${CRYPTO_SETTLEMENT_ENGINE}",
      "arguments": [],
      "profile": "engine",
      "inputs": [],
      "outputs": [
        "control/native_evidence_status.json",
        "ledger/spool",
        "native_engine.log",
        "research/native_observations"
      ],
      "dependencies": [],
      "exact_sha_required": true,
      "config_identity_required": true,
      "london_deployed": true,
      "runtime_class": "HOT_PATH",
      "authority_overrides": {
        "capital_allocator": true,
        "global_portfolio_coordinator": true,
        "inventory": true,
        "oms": true,
        "risk_engine": true,
        "runtime_identity": true
      }
    },
    {
      "id": "canonical_economics",
      "executable": "scripts/v7_canonical_economics.py",
      "arguments": [],
      "profile": "observer",
      "inputs": [
        "ledger/execution.jsonl"
      ],
      "outputs": [
        "canonical_economics.json",
        "canonical_economics.log"
      ],
      "dependencies": [
        "ledger_router"
      ],
      "exact_sha_required": true,
      "config_identity_required": true,
      "launcher_log": "canonical_economics.log",
      "london_deployed": true,
      "runtime_class": "CONTROL"
    }
  ]
}
