{
  "schema": "polymarket_autonomous_research_v1",
  "paper_only": true,
  "allow_authenticated_execution": false,
  "allow_direct_champion_mutation": false,
  "storage": {
    "database": "runs/research/autonomous_research.sqlite3",
    "raw_root": "runs/research/raw_external",
    "external_compatibility_csv": "runs/research/external_signals.csv",
    "external_status": "runs/research/external_data_status.json",
    "dispatcher_status": "runs/research/dispatcher_status.json",
    "cycle_status": "runs/research/autonomous_research_status.json"
  },
  "external_data": {
    "required_for_health": false,
    "max_active_signal_age_seconds": 3600,
    "critical_quarantine_limit": 0,
    "default_half_life_seconds": 21600,
    "minimum_mapping_confidence": 0.65
  },
  "evidence": {
    "require_unique_evidence_id": true,
    "require_non_overlapping_test_windows": true,
    "minimum_consecutive_independent_passes": 3,
    "portfolio_batch_trades": 30,
    "forward_batch_sessions": 24
  },
  "dispatcher": {
    "max_jobs_per_cycle": 3,
    "maximum_timeout_seconds": 1800,
    "allowed_interpreters": [
      "python3"
    ],
    "allowed_scripts": [
      "scripts/external_data_plane.py",
      "scripts/build_global_opportunity_book.py",
      "scripts/runtime_action_report.py"
    ],
    "forbidden_argument_tokens": [
      "--execute",
      "--submit",
      "--real-money",
      "--wallet",
      "--private-key"
    ]
  },
  "product_slos": {
    "global_opportunity_book_max_age_seconds": 600,
    "latest_experiment_result_max_age_seconds": 21600,
    "external_observations_max_age_seconds": 3600,
    "paper_runtime_max_age_seconds": 60,
    "walk_forward_lineage_max_age_seconds": 21600,
    "require_global_opportunity_book": false,
    "require_paper_runtime": true
  }
}
