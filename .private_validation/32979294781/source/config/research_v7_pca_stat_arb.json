{
  "schema_version": 1,
  "paper_only": true,
  "research_only": true,
  "live_intents_enabled": false,
  "model_family": "single_leg_pca_residual_stat_arb",
  "terminal_probability_interpretation": false,
  "hedge_legs_allowed": false,
  "horizons_minutes": [30, 60, 120, 360],
  "universe": {
    "maximum_markets": 1000,
    "minimum_liquidity_usd": 2.0,
    "maximum_clusters": 40,
    "minimum_cluster_markets": 3,
    "promotion_requires_point_in_time_or_forward_universe": true
  },
  "history": {
    "lookback_hours": 720,
    "fidelity_minutes": 30,
    "minimum_regular_common_points": 72,
    "require_regular_common_suffix": true,
    "allow_irregular_transition_as_one_bar": false
  },
  "pca": {
    "target_excluded_from_factor_estimation": true,
    "maximum_components": 3,
    "control_only_explained_variance_threshold": 0.80,
    "target_factor_ridge": 0.0001,
    "bootstrap_repetitions": 300,
    "bootstrap_type": "joint_panel_increment_blocks_reestimate_pca_and_target_factor",
    "bh_fdr": 0.10,
    "apply_bh_before_residual_z_and_economic_filters": true,
    "minimum_abs_residual_z_after_bh": 1.0
  },
  "execution_shadow": {
    "mode": "TAKER",
    "minimum_net_edge": 0.00005,
    "minimum_liquidity_usd": 2.0,
    "maximum_spread": 0.25,
    "slippage_bps": 5.0,
    "capital_cost_bps_per_hour": 0.25,
    "adverse_markout_penalty_bps": 2.0,
    "maximum_book_age_seconds": 30,
    "maximum_candidates_per_horizon": 20,
    "maximum_trade_usd": 60.0,
    "binary_kelly": false
  },
  "promotion_gate": {
    "require_valid_bh_survivors": true,
    "require_target_excluded_pca": true,
    "require_fixed_horizon_phi_power_forecast": true,
    "require_single_leg_only": true,
    "require_authoritative_market_fee": true,
    "require_fresh_executable_book": true,
    "require_shared_execution_ledger": true,
    "require_positive_fill_conditioned_cost_stressed_pnl": true,
    "require_point_in_time_or_forward_universe": true
  }
}
