{
  "schema_version": 1,
  "strategy": "MICRO_MAKER_PRO",
  "paper_only": true,
  "authenticated_execution": false,
  "real_order_submission": false,
  "mode": "explore_then_exploit",
  "architecture": {
    "single_runtime_owner": true,
    "single_account_allocator": true,
    "single_canonical_ledger_writer": true,
    "canonical_ledger_transport": "v7_ledger_spool",
    "fast_path": "cpp_websocket_event_driven",
    "slow_path": "python_reward_selection_and_model_fit"
  },
  "market_selection": {
    "max_active_markets": 40,
    "min_liquidity": 25.0,
    "min_volume_24h": 100.0,
    "min_mid": 0.02,
    "max_mid": 0.98,
    "rewarded_market_bonus": 1.0,
    "maker_rebate_market_bonus": 0.5,
    "weights": {
      "liquidity_reward": 0.30,
      "maker_rebate": 0.20,
      "spread_capture": 0.20,
      "compatible_flow": 0.15,
      "book_stability": 0.10,
      "competition_penalty": 0.05
    },
    "refresh_seconds": 60,
    "reward_settings_endpoint": "/rewards/markets/current",
    "reward_markets_endpoint": "/rewards/markets/multi"
  },
  "features": {
    "l2_levels": 5,
    "flow_windows_seconds": [1, 5, 15, 60, 300],
    "markout_horizons_seconds": [1, 10, 45, 60, 300],
    "include_microprice": true,
    "include_ofi": true,
    "include_depth_imbalance": true,
    "include_queue_ahead": true,
    "include_trade_signs": true,
    "include_short_volatility": true,
    "include_time_to_resolution": true,
    "include_inventory": true,
    "include_reward_context": true,
    "include_related_market_state": true
  },
  "fair_value": {
    "mid_weight": 0.40,
    "microprice_weight": 0.45,
    "flow_weight": 0.10,
    "related_market_weight": 0.05,
    "max_microstructure_shift_ticks": 2.0,
    "directional_alpha_required": false
  },
  "quoting": {
    "actions": ["JOIN", "IMPROVE1", "FADE1", "FADE2", "ONE_SIDED", "WITHDRAW"],
    "post_only": true,
    "two_sided_preferred": true,
    "one_sided_allowed": true,
    "min_quote_lifetime_ms": 100,
    "max_quote_lifetime_ms": 5000,
    "cancel_replace_cooldown_ms": 50,
    "cancel_latency_ms": 100,
    "max_inside_ticks": 1,
    "reward_qualified_quotes_preferred": true,
    "never_cross_spread": true,
    "minimum_exploit_ev_per_dollar": 0.00001,
    "inventory_skew_strength": 1.0,
    "toxicity_withdraw_threshold": 0.75
  },
  "exploration": {
    "enabled": true,
    "promotion_credit": false,
    "max_capital_fraction": 0.02,
    "max_market_fraction": 0.0025,
    "max_quote_notional_fraction": 0.001,
    "minimum_rest_ms": 250,
    "maximum_rest_ms": 3000,
    "actions": ["JOIN", "FADE1", "IMPROVE1"],
    "epsilon": 0.10,
    "require_fresh_dual_clock_book": true,
    "require_post_only": true
  },
  "execution_model": {
    "fill_model": "empirical_beta_logistic_hybrid",
    "markout_model": "fill_conditioned_horizon_regression",
    "joint_yes_no_model": "direct_empirical_state_distribution",
    "product_of_marginals_forbidden": true,
    "minimum_orders_for_exploit": 50,
    "minimum_fills_for_exploit": 20,
    "minimum_event_clusters_for_promotion": 12,
    "minimum_positive_fold_fraction": 0.60,
    "embargo_seconds": 60,
    "cold_start_fill_prior": 0.02,
    "cold_start_adverse_markout_per_share": 0.002
  },
  "inventory": {
    "balanced_complete_sets_preferred": true,
    "allow_temporary_directional_inventory": true,
    "auto_split_merge_accounting": true,
    "reservation_price_skew": true,
    "max_directional_inventory_fraction": 0.025,
    "soft_directional_inventory_fraction": 0.0125,
    "max_market_gross_fraction": 0.05,
    "max_event_gross_fraction": 0.10,
    "max_maker_gross_fraction": 0.30,
    "unwind_full_visible_depth_required": true,
    "fail_closed_if_unmarkable": true
  },
  "capital": {
    "target_account_fraction_for_paper_evidence": 0.60,
    "kelly_ceiling": 0.25,
    "queue_never_grants_size": true,
    "size_from_capital_depth_and_ev_only": true
  },
  "rewards": {
    "maker_fee": 0.0,
    "maker_rebates_enabled": true,
    "liquidity_rewards_enabled": true,
    "liquidity_reward_scaling_c": 3.0,
    "reward_haircut_for_decisions": 0.50,
    "rebate_haircut_for_decisions": 0.50,
    "trading_pnl_separate": true,
    "maker_rebate_pnl_separate": true,
    "liquidity_reward_pnl_separate": true,
    "subsidy_dependent_label_required": true,
    "promotion_requires_positive_total_pnl_after_50pct_reward_haircut": true,
    "promotion_requires_no_catastrophic_negative_trading_pnl": true
  },
  "risk": {
    "global_drawdown_ceiling": 0.15,
    "maker_sleeve_drawdown_soft": 0.05,
    "maker_sleeve_drawdown_hard": 0.10,
    "max_order_fraction_of_sleeve": 0.01,
    "max_open_orders_per_market": 8,
    "max_active_markets": 40,
    "news_toxicity_fail_closed": true,
    "stale_book_fail_closed": true,
    "unknown_reward_or_fee_data_fail_closed_for_reward_credit": true
  },
  "latency": {
    "event_driven": true,
    "rest_polling_not_allowed_on_quote_fast_path": true,
    "target_decision_p50_us": 250,
    "target_decision_p99_us": 1500,
    "target_cancel_decision_p99_us": 1000,
    "max_feed_age_ms": 5000,
    "max_rest_snapshot_age_ms": 5000,
    "max_cross_book_skew_ms": 1500,
    "ws_reconnect_invalidates_lineage": true
  },
  "evidence": {
    "exact_sha_required": true,
    "canonical_ledger_required": true,
    "same_trade_cost_stress": [1.0, 1.5, 2.0],
    "reward_stress_multipliers": [1.0, 0.5, 0.0],
    "event_cluster_inference": true,
    "report_fill_conditioned_markout": true,
    "report_queue_position": true,
    "report_cancel_latency": true,
    "report_inventory_duration": true
  }
}
